PORT=
CLIENT_URL=
SERVER_PUBLIC_URL=

# For production VPS:
# CLIENT_URL=https://social.getaipilot.in
# SERVER_PUBLIC_URL=https://api.getaipilot.in

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Trend feed ingestion
YOUTUBE_DATA_API_KEY=
TREND_YOUTUBE_CRON=
TREND_YOUTUBE_REGIONS=
TREND_YOUTUBE_CATEGORY_IDS=
TREND_YOUTUBE_MAX_RESULTS=

# Reddit trend ingestion uses the official OAuth API only. Keep usage within Reddit's free-tier/non-commercial limits.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
TREND_REDDIT_CRON=
TREND_REDDIT_SUBREDDITS=
TREND_REDDIT_LIMIT=

# Bluesky trend ingestion uses the public Jetstream firehose, no credentials.
TREND_BLUESKY_JETSTREAM_URL=
TREND_BLUESKY_BATCH_SIZE=
TREND_BLUESKY_FLUSH_MS=
TREND_BLUESKY_INCLUDE_REPLIES=false
AUTODM_SUPABASE_URL=
AUTODM_SUPABASE_SERVICE_KEY=
AUTODM_SUPABASE_JWT_SECRET=
AUTODM_TOKEN_ENCRYPTION_KEY_BASE64=

# BullMQ broadcast worker
# Use a managed Redis/Valkey URL in production, for example Upstash/Redis Cloud.
REDIS_URL=
TREND_FEED_CACHE_TTL_SECONDS=
INBOX_PROVIDER_TIMEOUT_MS=3500
INBOX_CACHE_TTL_SECONDS=60
INBOX_SYNC_CRON=*/3 * * * *
INBOX_AUTH_ERROR_COOLDOWN_HOURS=24
BROADCAST_QUEUE_NAME=
BROADCAST_WORKER_CONCURRENCY=
BROADCAST_MAX_ATTEMPTS=
SCHEDULER_BATCH_SIZE=
SCHEDULER_CRON=
SCHEDULER_STALE_PROCESSING_MINUTES=

# Local OAuth callbacks should use your ngrok URL.
# Production OAuth callbacks should use https://api.getaipilot.in.
INSTAGRAM_REDIRECT_URI=

# Pinterest Official OAuth 2.0 Credentials
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=

# BullMQ and Scheduler Settings
BROADCAST_QUEUE_NAME=
BROADCAST_WORKER_CONCURRENCY=
BROADCAST_MAX_ATTEMPTS=
SCHEDULER_BATCH_SIZE=
SCHEDULER_CRON=
SCHEDULER_STALE_PROCESSING_MINUTES=

# SupermailBox CPaaS Integration
SUPERMAILBOX_API_KEY=

# Hub (GetAiPilot) Configuration
HUB_SUPABASE_URL=
HUB_SUPABASE_ANON_KEY=
